# BetterAndBetter CLI Configuration Example
# Copy to .env or export in your shell

# Path to the BetterAndBetter local backup directory
# BAB_BACKUP_REPO=/path/to/BetterAndBetter/backup

# Custom path to main preferences plist (optional)
# BAB_BACKUP_PREFS=

# Custom path to helper preferences plist (optional)
# BAB_BACKUP_HELPER_PREFS=

# Custom path to presets directory (optional)
# BAB_BACKUP_PRESETS=
